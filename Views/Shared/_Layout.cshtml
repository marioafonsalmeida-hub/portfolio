<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Portfolio.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-light bg-white border-bottom box-shadow" aria-label="Main navigation">
            <div class="container-fluid">
                <div class="row w-100">
                    <div class="col-4 text-center">
                        <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </div>
                    <div class="col-4 text-center">
                        <a class="nav-link text-white" asp-area="" asp-controller="Gallery"
                            asp-action="Index">Stills</a>
                    </div>
                    <div class="col-4 text-center">
                        <a class="nav-link text-white" asp-area="" asp-controller="About" asp-action="Index">About</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="main-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    @* <div class="socials">
        <a href="https://www.instagram.com/mario_almeida3d/" title="Instagram" target="_blank">
            <img src="~/icons/instagram.svg" alt="Instagram" />
        </a>
    </div> *@

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>